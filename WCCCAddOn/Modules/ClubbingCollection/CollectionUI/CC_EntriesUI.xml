<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\..\FrameXML\UI.xsd">
    <Script file="CC_EntriesUI.lua"/>

    <!-- Collection entry -->
    <Button name="CC_EntryTemplate" mixin="CC_EntryMixin" virtual="true">
        <Size y="64"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" setAllPoints="true"/>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" file="Interface\Icons\INV_Misc_QuestionMark">
                    <Size x="32" y="32"/>
                    <Anchors>
                        <Anchor point="LEFT" x="5" y="0"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="IconBorder" file="Interface\Common\WhiteIconFrame">
                    <Size x="38" y="38"/>
                    <Anchors>
                        <Anchor point="CENTER" relativeKey="$parent.Icon"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="NameLabel" inherits="GameFontNormalLarge" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Icon" relativePoint="TOPRIGHT" x="10" y="0"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="ClueLabel" inherits="GameFontNormal" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.NameLabel" relativePoint="BOTTOMLEFT" x="0" y="-3"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="RestrictionsPrompt" text="Hover to view requirements" inherits="GameFontDisableSmall" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.DescLabel" relativePoint="BOTTOMLEFT" x="0" y="-3"/>
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD" setAllPoints="true"/>
            </Layer>
        </Layers>
        <Scripts>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
        </Scripts>
    </Button>

    <!-- List of entries -->
    <Frame name="CC_EntriesListTemplate" mixin="CC_EntriesListMixin" virtual="true">
        <Frames>
            <Frame parentKey="Container" inherits="TooltipBackdropTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>
                <KeyValues>
                    <KeyValue key="backdropColor" value="BLACK_FONT_COLOR" type="global"/>
                    <KeyValue key="backdropColorAlpha" value="0.9" type="number"/>
                </KeyValues>
                <Layers>
                    <Layer level="OVERLAY">
                    </Layer>
                </Layers>
                <Frames>
                    <Frame parentKey="ScrollBox" inherits="WowScrollBoxList" frameStrata="HIGH">
                        <Anchors>
                            <Anchor point="TOPLEFT" x="6" y="-6"/>
                            <Anchor point="BOTTOMRIGHT" x="-28" y="6"/>
                        </Anchors>
                    </Frame>
                    <EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar" frameStrata="HIGH">
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT" x="5" y="0"/>
                            <Anchor point="BOTTOM" relativeKey="$parent.ScrollBox" relativePoint="BOTTOM" y="0"/>
                        </Anchors>
                    </EventFrame>
                </Frames>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
        </Scripts>
    </Frame>
</Ui>
