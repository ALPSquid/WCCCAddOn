<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\..\FrameXML\UI.xsd">
    <Script file="CC_ZoneListUI.lua"/>

    <!-- Zone entry -->
    <Button name="CC_ZoneEntryTemplate" mixin="CC_ZoneEntryMixin" virtual="true">
        <Size y="24"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="SelectedTexture" setAllPoints="true" hidden="true">
                    <Color r="1" g="0.82" b="0" a="0.15"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY" textureSubLevel="1">>
                <FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="LEFT" x="8" y="0"/>
                        <Anchor point="RIGHT" x="-4" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="OVERLAY" textureSubLevel="2">
                <Texture parentKey="SelectedOverlay" file="Interface\QuestFrame\UI-QuestTitleHighlight" useAtlasSize="true" hidden="true">
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture parentKey="HighlightOverlay" file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD" setAllPoints="true">
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
        </Scripts>
    </Button>

    <!-- Zone list -->
    <Frame name="CC_ZoneListTemplate" mixin="CC_ZoneListMixin" virtual="true">
        <Frames>
            <Frame parentKey="Container" inherits="TooltipBackdropTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>
                <KeyValues>
                    <KeyValue key="backdropColor" value="BLACK_FONT_COLOR" type="global"/>
                    <KeyValue key="backdropColorAlpha" value="0.9" type="number"/>
                </KeyValues>
                <Frames>
                    <Frame parentKey="ScrollBox" inherits="WowScrollBoxList" frameStrata="HIGH">
                        <Anchors>
                            <Anchor point="TOPLEFT" x="4" y="-6"/>
                            <Anchor point="BOTTOMRIGHT" x="-20" y="6"/>
                        </Anchors>
                    </Frame>
                    <EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar" frameStrata="HIGH">
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT" x="5" y="0"/>
                            <Anchor point="BOTTOM" relativeKey="$parent.ScrollBox" relativePoint="BOTTOM" y="0"/>
                        </Anchors>
                    </EventFrame>
                </Frames>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
        </Scripts>
    </Frame>
</Ui>
